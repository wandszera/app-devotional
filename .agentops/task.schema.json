{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.app-devocional/task.schema.json",
  "title": "AgentOps Task",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "objective",
    "status",
    "complexity",
    "risk",
    "dependencies",
    "allowedPaths",
    "forbiddenActions",
    "acceptanceCriteria",
    "verification",
    "worktreePath"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 5 },
    "objective": { "type": "string", "minLength": 10 },
    "status": {
      "type": "string",
      "enum": ["backlog", "ready", "running", "review", "blocked", "done"]
    },
    "complexity": { "type": "string", "enum": ["simple", "complex"] },
    "risk": { "type": "string", "enum": ["low", "medium", "high"] },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "allowedPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "forbiddenActions": { "type": "array", "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "verification": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "worktreePath": { "type": "string", "minLength": 1 },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "plannerTier": { "type": "string", "enum": ["simple", "complex"] },
    "executorTier": { "type": "string", "enum": ["simple", "complex"] },
    "baseCommit": { "type": ["string", "null"] },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["ready", "running", "review", "done"] }
        }
      },
      "then": {
        "properties": {
          "worktreePath": {
            "type": "string",
            "minLength": 3,
            "not": { "const": "TBD" }
          },
          "baseCommit": { "type": "string", "minLength": 7 }
        }
      }
    }
  ]
}
